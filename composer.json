{
  "name": "magpern/universal-product-reviews",
  "description": "Portable WooCommerce product-review operations plugin (UPR).",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "wp-phpunit/wp-phpunit": "^7.0",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "UniversalProductReviews\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "UniversalProductReviews\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
    "ci": "bash scripts/ci/check.sh",
    "test:unit": "phpunit -c phpunit.xml.dist",
    "test:integration": "phpunit -c phpunit-integration.xml.dist"
  },
  "config": {
    "platform": {
      "php": "8.1.99"
    },
    "sort-packages": true
  }
}
